const express = require('express');
const axios = require('axios');
const app = express();
const port = 3000;

// Replace 'YOUR_API_KEY' with your actual Weatherstack API key
const API_KEY = 'YOUR_API_KEY';
const WEATHER_API_URL = 'http://api.weatherstack.com/current';

app.use(express.json());

app.get('/weather', async (req, res) => {
    const city = req.query.city;
    if (!city) {
        return res.status(400).json({ error: 'City parameter is required' });
    }

    try {
        const response = await axios.get(WEATHER_API_URL, {
            params: {
                access_key: API_KEY,
                query: city
            }
        });
        const data = response.data;

        if (data.success === false) {
            return res.status(404).json({ error: data.error.info });
        }

        const weather = {
            location: data.location.name,
            temperature: data.current.temperature,
            weather_descriptions: data.current.weather_descriptions[0],
            wind_speed: data.current.wind_speed,
            humidity: data.current.humidity
        };

        res.json(weather);
    } catch (error) {
        res.status(500).json({ error: 'Failed to fetch weather data' });
    }
});

app.listen(port, () => {
    console.log(`Weather service running at http://localhost:${port}`);
});
